If:
  PathMatch: .*\.c$
CompileFlags:
  Add:
    - -std=c23
    - --target=x86_64-apple-darwin
    - -I/opt/homebrew/opt/ncurses/include
    - -I/usr/local/opt/ncurses/include
---
If:
  PathMatch: .*\.cpp$
CompileFlags:
  Add:
    - -std=c++23
    - --target=x86_64-apple-darwin
    - -I/opt/homebrew/opt/ncurses/include
    - -I/usr/local/opt/ncurses/include
